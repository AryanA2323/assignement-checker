# Gemini API Key for handwritten evaluation
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=

# Default Gemini model (gemini-2.5-flash is fast and highly accurate for vision/OCR)
GEMINI_MODEL=gemini-2.5-flash

# Evaluation Strictness: lenient, standard, strict
DEFAULT_STRICTNESS=standard

# Confidence threshold below which an assignment is flagged for manual teacher review (0-100)
MANUAL_REVIEW_THRESHOLD=70
